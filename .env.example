# Public, safe to expose in the browser. Username only, without @.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Server-only Telegram Bot API token used only to validate raw Mini App initData.
TELEGRAM_BOT_TOKEN=

# Server-only integration settings. Optional until the owning slice is enabled.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hvostokratia
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hvostokratia-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
